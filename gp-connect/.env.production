# Production Environment Variables for Vercel
# Copy these to Vercel Environment Variables Dashboard

# Backend API URL (UPDATE WITH YOUR RENDER URL)
VITE_API_BASE_URL=https://gp-connex-backend.onrender.com/api

# WebSocket URL (UPDATE WITH YOUR RENDER URL)
VITE_SOCKET_URL=https://gp-connex-backend.onrender.com

# Chat encryption secret (MUST MATCH BACKEND CHAT_SECRET)
VITE_CHAT_SECRET=your-super-secret-chat-key-change-this-in-production-must-match-backend

# Instructions:
# 1. Replace YOUR-RENDER-APP-NAME with your actual Render service name
# 2. Generate a strong CHAT_SECRET (32+ characters) and use the SAME value in backend
# 3. Add these variables to Vercel Dashboard → Project Settings → Environment Variables
# 4. Make sure to add for Production, Preview, and Development environments
