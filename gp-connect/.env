# Chat encryption secret (must match between frontend and backend concept)
# This is used to encrypt/decrypt messages on the client side
VITE_CHAT_SECRET=my-super-secret-chat-key-change-this-in-production

# API Base URL (optional, defaults to http://localhost:5000/api)
# VITE_API_BASE_URL=http://localhost:5000/api

# WebSocket URL (optional, defaults to http://localhost:5000)
# VITE_SOCKET_URL=http://localhost:5000
